{
  "name": "dsh-nvim-tui",
  "version": "0.2.8",
  "description": "Neovim-style TUI for DeepSeek Harness (dsh): nvim renders the terminal, a Node runner bridges DSH agent events over msgpack-RPC — sessions, tool cards, reasoning panel, approvals, markdown tables",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "nvim",
    "cordis.patch.yml",
    "README.md",
    "UPGRADE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "smoke": "node scripts/smoke.ts",
    "prepublishOnly": "npm run check && npm run build && node scripts/smoke.ts",
    "e2e": "node scripts/e2e.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "neovim": "^5.4.0",
    "string-width": "^8.2.2",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=23.6"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "tui",
    "neovim",
    "terminal"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.2",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
