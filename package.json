{
  "name": "dsh-nvim-tui",
  "version": "0.4.7",
  "description": "Neovim-style TUI for DeepSeek Harness (dsh): nvim renders the terminal, a Node runner bridges DSH agent events over msgpack-RPC — sessions, tool cards, reasoning panel, approvals, markdown tables",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "nvim",
    "!nvim/**/*.log",
    "docs",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "UPGRADE.md",
    "REQUIREMENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && node scripts/check-arch.mjs && node scripts/app-ops-check.mjs",
    "smoke": "npm run build && node scripts/smoke.ts",
    "prepublishOnly": "npm run check && npm run build && node scripts/smoke.ts",
    "e2e": "node scripts/e2e.ts",
    "i18n:report": "node scripts/i18n-check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "neovim": "^5.4.0",
    "string-width": "^8.2.2",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=23.6"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "tui",
    "neovim",
    "terminal"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.1.7-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.7-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.7-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.7-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.7-rc.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
