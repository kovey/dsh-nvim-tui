# dependencies / package managers
node_modules/
.pnpm-store/
.npm-cache/

# dsh test profile: local harness state, not project source
.dsh-test/

# throwaway harness homes/profiles used by upgrade + e2e verification
# (DSH_HOME replicas): local scratch state, never project source
.probe-home/
.crash-home/
.scratch-home/
.scratch-host/
.rt-home/

# project-local dsh memory / runtime state
.dsh/*
# gate configs are repo-owned and reviewed; only the JSON configs are tracked
!.dsh/engineering-suite/
!.dsh/engineering-suite/*.json
.dsh/engineering-suite/missions/
.dsh/engineering-suite/audit/
.dsh/engineering-suite/state/
.dsh/engineering-suite/kb/
.dsh/engineering-suite/specs/
.dsh/engineering-suite/*.jsonl

# logs
*.log

# OS junk
.DS_Store

# local Swift/OCR module cache (never project source)
.tmp-swift/
